+  const rarities=[...new Set(rs.map(r=>Number(r.rarity)).filter(Number.isInteger))];
+  if(rarities.length!==1||!Object.hasOwn(CHARM_RARITY_NAMES,rarities[0])||rs.some(r=>(r.skills||[]).length))return null;
